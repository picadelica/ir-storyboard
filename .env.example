# ----- Production deployment (docker-compose.prod.yml) -----

# Public domain pointing to your VPS (A-record set in DNS).
DOMAIN=ir.your-agency.com

# Email for Let's Encrypt notifications (cert expiry, etc.).
ADMIN_EMAIL=admin@your-agency.com

# ----- Local-only deploy (docker-compose.yml without prod) -----
# Host port the frontend is published on (bound to 127.0.0.1).
HOST_PORT=8000

# ----- LLM providers (optional — system works without them via keyword stubs) -----

# Anthropic Claude — enables batch fact classification + cycle content generation.
# ANTHROPIC_API_KEY=sk-ant-...

# Tavily — enables real web search in online_research channel.
# TAVILY_API_KEY=tvly-...
