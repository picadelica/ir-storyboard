# ----- Production deployment (docker-compose.prod.yml) -----

# Public domain pointing to your VPS (A-record set in DNS).
DOMAIN=ir.your-agency.com

# Email for Let's Encrypt notifications (cert expiry, etc.).
ADMIN_EMAIL=admin@your-agency.com

# ----- Local-only deploy (docker-compose.yml without prod) -----
# Host port the frontend is published on (bound to 127.0.0.1).
HOST_PORT=8000

# ----- Auth: центральный шлюз tg-authgw (optional — unset = open, no login) -----
# Логин делегирован общему auth-боту через шлюз tg-authgw; доступ = членство в
# группе продукта ir-storyboard. Сессия проверяется ЛОКАЛЬНО (SESSION_SECRET =
# секрет продукта ir-storyboard в конфиге шлюза). Оба AUTHGW_URL + SESSION_SECRET
# заданы → /api/* под гейтом; любой пуст → open (local dev / tests).
# Раньше здесь был свой поллер (TELEGRAM_AUTH_BOT_TOKEN/TELEGRAM_GROUP_ID) — теперь
# поллер у шлюза (единственный getUpdates-консьюмер общего бота).
#
# URL шлюза (на сервере — docker-bridge, не публично).
# AUTHGW_URL=http://172.17.0.1:8091
# Имя продукта в карте AUTHGW_PRODUCTS шлюза.
# AUTHGW_PRODUCT=ir-storyboard
# Секрет подписи сессий = session_secret продукта ir-storyboard в конфиге шлюза.
# SESSION_SECRET=

# ----- LLM providers (optional — system works without them via keyword stubs) -----

# Anthropic Claude — enables batch fact classification + cycle content generation.
# ANTHROPIC_API_KEY=sk-ant-...

# Tavily — enables real web search in online_research channel.
# TAVILY_API_KEY=tvly-...
