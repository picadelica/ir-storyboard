# ----- Production deployment (docker-compose.prod.yml) -----

# Public domain pointing to your VPS (A-record set in DNS).
DOMAIN=ir.your-agency.com

# Email for Let's Encrypt notifications (cert expiry, etc.).
ADMIN_EMAIL=admin@your-agency.com

# ----- Local-only deploy (docker-compose.yml without prod) -----
# Host port the frontend is published on (bound to 127.0.0.1).
HOST_PORT=8000

# ----- Auth: Telegram group membership (optional — unset = open, no login) -----
# When all three are set, /api/* is gated behind a Telegram login: the user taps
# the auth bot, and access requires membership of the work supergroup. Unset any
# of them and the app runs open (local dev / tests).
#
# Dedicated auth bot token from @BotFather (NOT the deploy-notification bot —
# long-polling getUpdates can't be shared).
# TELEGRAM_AUTH_BOT_TOKEN=123456:AA...
# Work supergroup id (bot must be a member/admin). Negative, e.g. -1004413258345.
# TELEGRAM_GROUP_ID=-1004413258345
# Random secret for signing session cookies (e.g. `openssl rand -hex 32`).
# SESSION_SECRET=

# ----- LLM providers (optional — system works without them via keyword stubs) -----

# Anthropic Claude — enables batch fact classification + cycle content generation.
# ANTHROPIC_API_KEY=sk-ant-...

# Tavily — enables real web search in online_research channel.
# TAVILY_API_KEY=tvly-...
